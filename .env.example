# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration
# Copy this file: cp .env.example .env
# Only .env.example is committed to Git — never commit your real .env!
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development    # 'development' | 'production'

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev:   redis://localhost:6379
# Docker:      redis://redis:6379  (Docker resolves "redis" → container IP)
REDIS_URL=redis://localhost:6379

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT=10           # Default max requests per window per client (overridden by tier)
WINDOW_SECONDS=60       # Default window duration in seconds (overridden by tier)

# Starting algorithm — can be changed at runtime via POST /api/admin/config
# Options:
#   fixed-window           → O(1) fast atomic counter (Redis INCR + EXPIRE)
#   sliding-window         → Perfect accuracy via Redis Sorted Set log
#   token-bucket           → Smooth burst handling with token refill
#   sliding-window-counter → Atomic Lua script (Cloudflare/Stripe pattern)
RATE_LIMIT_STRATEGY=fixed-window

# ── Admin API ──────────────────────────────────────────────────────────────────
# Secret key required to access /api/admin/* endpoints (config, redis-keys, simulate).
# If not set, admin plane is DISABLED in production and open in development.
# Generate a secure key: openssl rand -hex 32
ADMIN_API_KEY=
